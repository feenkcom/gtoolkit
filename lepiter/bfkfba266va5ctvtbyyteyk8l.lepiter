											"__type" : "email",
											"emailString" : "alistairgrant@fastmail.com.au"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-09-29T17:36:31.216455+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "alistairgrant@fastmail.com.au"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-10-28T14:12:13.925162+01:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "SI/vY+wfRJSxEDMPPhzH8w=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "Adding a pragma with the `<gsCode: gemstoneSourceString>` pragma to the method will result in the gemstoneSourceString being used when the code is exported (see {{gtClass:GtGemStoneGtCodeExporter}}).  An example is {{gtMethod:GtGemStoneTopazExporterExamples>>#gsCodeExampleMethod}}.\nNOTE: the `gemstoneSourceString` replaces everything below the pragma, meaning that the method signature doesn't need to be included, so in the example linked above the method signature and comment will be part of the generated GemStone code."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
