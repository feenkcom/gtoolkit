							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The native `ZnStringEntity` uses a null encoder when no charset is given, which corrupts non-ASCII bodies.  JSON entities must declare `charset=utf-8`."
						},
