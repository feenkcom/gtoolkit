							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "There are many differences between GT and GemStone classes.  Where GemStone requires an alternate implementation there are a few different potential solutions:"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
