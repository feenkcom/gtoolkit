									"dateAndTimeString" : "2026-09-30T12:32:49.321662+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "mLvYC671TyGQZ5i/sUvLmA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "GemStone will commit the value of class and class-instance variables to the database.  In general, this is not what is desired when porting code.  In particular, class methods that answer a `default`, `instance` or `uniqueInstance` that store the instance in a class or class-instance variable should not store the value in the database.  In these cases they should be added to `SessionTemps` with a name based on the class and accessor method, e.g.  `SessionTemps current at: #Class_selector_value ifAbsentPut: [ self new ]`."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "alistairgrant@fastmail.com.au"
				},
