							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "When modifying an existing method, check what it's protocol is, and unless it is 'as yet unclassified', DO NOT CHANGE THE PROTOCOL unless explicitly requested.  This is particularly important for EXTENSION METHODS (where the protocol begins with a '*').  If you feel the need to change a protocol, stop and ask for confirmation"
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
