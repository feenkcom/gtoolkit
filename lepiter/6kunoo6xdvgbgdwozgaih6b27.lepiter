					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-22T16:32:31.753292+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "FvlrS/izRiG+7xqxxbxZkw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "# Design decisions"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:36:02.23118+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:36:26.673034+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "O1JrdnlZRO20POAzelDDSw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Most announcers never get a weak subscriber (11,845 of 12,529 Lepiter announcers in a load of the Glamorous Toolkit Book at the moment when this was added), so the weak part is an object of its own:\n\n- {{gtClass:GtNoWeakSubscriptions}} has no state; all registries without weak subscribers share {{gtMethod:GtNoWeakSubscriptions class>>#uniqueInstance}}, and nothing can change it.\n- {{gtClass:GtWeakSubscriptions}} holds the dictionary of ephemerons and is never empty.\n- Every change is made in place and answers the part the registry keeps from then on: adding to the empty part answers a new {{gtClass:GtWeakSubscriptions}} ({{gtMethod:GtNoWeakSubscriptions>>#withEphemeron:}}), removing the last subscriber answers the shared empty part again ({{gtMethod:GtWeakSubscriptions>>#withoutSubscriber:}}). {{gtMethod:GtMixedSubscriptionRegistryExamples>>#randomChangesKeepTheWeakPartConsistent}} checks this after each of 2,000 random changes.\n"
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-22T16:36:00.045323+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
