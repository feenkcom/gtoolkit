											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-11-22T16:40:18.607102+01:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-11-22T16:40:18.607102+01:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "c8ya1QRGSFiXvOpfFZtiHA=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "- **Coder announcers.** In an image with many large Lepiter databases there were about 30,000 {{gtClass:GtCoderAnnouncer}}s with no strong subscriptions and about 70,000 weak ones, most of them from code snippets, each with a global entry. With the mixed registry in {{gtMethod:GtCoderModel>>#initialize}} those entries would go away; a doit that switched one coder delivered and collected as before. An alternative for the snippets is to let the coder call its snippet directly instead of announcing to it."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-11-22T16:39:24.760045+01:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-11-22T16:40:18.612501+01:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "DWMWwq85Q7CjWoeNAk8zeQ=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "- **Text announcers.** {{gtMethod:BlTextElement>>#text:}} unsubscribes from the old text and subscribes weakly to the new one, so a reused list label that showed 200 texts leaves 200 stale global entries with a plain registry and none with the mixed one.\n"
									}
								]
							},
