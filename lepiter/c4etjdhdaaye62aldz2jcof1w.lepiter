							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Every 3 minutes (the poll interval, {{gtMethod:GtGemStoneSessionKeepAlive class>>#defaultPollInterval|label=#selector}}) the keep alive looks at each connected session of the registry. The poll of a single session is done by {{gtMethod:GtGemStoneSessionKeepAlive>>#pollSession:}}:"
						}
					]
