					"uidString" : "AHhrsqyaSuW+OVCplTmx1A=="
				},
				"code" : "sessionId := 'your-session-id'.\nsession := claudeStore\n    loadSession: sessionId\n    configureClient: [ :client |\n        client configuration requestTimeout: 180 ].\nsession"
