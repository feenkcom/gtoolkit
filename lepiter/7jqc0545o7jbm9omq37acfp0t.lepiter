				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "When only the ID is known, traverse both stores using {{gtMethod:GtLACPExternalSessionStore>>sessionWithId:ifPresent:}}:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-07T00:28:38.240639+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-07T00:28:38.240639+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "16Nk5A0aTfex4pEJbus4Jw=="
				},
				"code" : "sessionId := 'your-session-id'.\nsession := nil.\nstores := {\n    GtLACPClaudeCodeSessionStore new read.\n    GtLACPCodexSessionStore new read }.\n\nstores do: [ :store |\n    store\n        sessionWithId: sessionId\n        ifPresent: [ :storedSession |\n            session := store\n                loadSession: storedSession sessionId\n                configureClient: [ :client |\n                    client configuration requestTimeout: 180 ] ] ].\n\nsession"
			},
