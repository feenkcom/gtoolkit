									"dateAndTimeString" : "2026-11-22T16:25:43.574356+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:26:49.992975+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "33HHoipTRRqxPgxz/AQICA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Lepiter models (pages, snippets, databases and their store monitors) create their announcers through {{gtMethod:LeUseMixedSubscriptionRegistryFlag class>>#newAnnouncer}}. The flag {{gtClass:LeUseMixedSubscriptionRegistryFlag}} is disabled by default; when it is enabled, models created afterwards use the mixed registry, so it must be enabled before the databases are loaded. With the flag enabled, a load of the Glamorous Toolkit Book needs 2,051 fewer global finalization entries, one per model subscription. {{gtMethod:LeUseMixedSubscriptionRegistryFlag class>>#usePlainSubscriptionRegistriesIn:}} moves the announcers of a loaded database back to plain registries if needed."
						}
					]
				},
