							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:27:09.980791+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-23T15:42:55.324713+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "Zc1xZI/SRKCpQwItQlubcQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "| | {{gtClass:SubscriptionRegistry}} | {{gtClass:FastSubscriptionRegistry}} | {{gtClass:GtMixedSubscriptionRegistry}} |\n|---|---|---|---|\n| Used by | every new {{gtClass:Announcer}} | {{gtClass:SystemAnnouncer}} in GT | announcers that opt in |\n| Strong subscription keeps its subscriber alive | yes | no | yes |\n| Global finalization entry per weak subscription | yes | yes | no |\n| A live weak subscriber keeps the announcer alive | yes, with its strong subscribers | yes | no |\n| A weak block subscription whose block refers to its subscriber keeps it alive | yes | no | no |\n| Something left behind after unsubscribing | yes, until the subscriber dies | yes, until the subscriber dies | no |\n\n"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:25:43.574345+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-22T16:27:09.991171+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "mcFzRw9bQs2gBCq0qgYZ0A=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "{{gtClass:SubscriptionRegistry}} is Pharo's registry. {{gtClass:FastSubscriptionRegistry}} is the registry GT installs for the {{gtClass:SystemAnnouncer}}; it keys all subscriptions by subscriber in a weak-key dictionary, so not even its strong subscriptions keep their subscribers alive."
						}
					]
				},
