					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-22T16:26:07.431337+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
