									"dateAndTimeString" : "2026-09-01T17:23:31.118458+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "GWHXCgl3RQG3Ol/4h4Gmng=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "It does **not** define its own specification or data source. {{gtMethod:GtRemotePhlowPictureView>>#asGtDeclarativeView}} uses {{gtClass:GtRemotePhlowConcreteDataViewSpecification}} and {{gtClass:GtRemotePhlowConcreteDataViewDataSource}}. The generic datasource calls {{gtMethod:GtRemotePhlowPictureView>>#computeViewData}}, captures errors, and the generic specification handles lazy/included transport, reconstruction, refresh, and rendering."
						},
