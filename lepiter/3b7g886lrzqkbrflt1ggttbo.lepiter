							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "{{gtClass:GtRemotePhlowPictureView}} is the preferred model for a new view that computes one cohesive custom data object. The application defines:"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-09-01T17:23:31.118458+02:00"
								}
							},
