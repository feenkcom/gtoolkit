							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "{{gtClass:GtRemotePhlowWebBrowserView}} demonstrates when the generic concrete-data pipeline is too narrow. It has independently retrieved browser content and dynamic headers, static headers, merging rules, custom cache clearing, and specialized Update behavior. These responsibilities require custom collaborators:"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
