				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Create a {{gtClass:GtLACPClaudeCodeClient}} with a request timeout of 180 seconds:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
