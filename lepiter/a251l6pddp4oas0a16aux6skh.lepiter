								"__type" : "uid",
								"uidString" : "82UYk1HwQNioh8H+Oc4b7Q=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Its {{gtMethod:GtRemotePhlowWebBrowserViewSpecification>>#viewFor:}} still follows the same essential rendering rule: create an explicit view, set {{gtMethod:GtPhlowView>>#phlowViewSpecification:|label=#selector}}, and use {{gtMethod:GtPhlowExplicitView>>#declarativeStencil:|label=#selector}}. {{gtMethod:GtRemotePhlowWebBrowserViewSpecification>>#createDeclarativeContentStencil}} retrieves/merges the values and answers {{gtClass:GtRemotePhlowWebBrowserStencil}} or {{gtClass:GtPhlowErrorStencil}}."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
