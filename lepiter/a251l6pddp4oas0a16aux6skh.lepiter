				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## Architecture overview"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:39.688592+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:39.688592+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "NZidqiV2T/ufrtI0SWYLsA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The data flows through these stages:"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:41.206488+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:57.794435+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "goZl+pU6SUSjnu1A+i1+iA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "1. A {{gtPragma:gtView}} method calls `aView picture` (or similar) which creates the **View** instance and configures it with computation blocks."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-09-01T13:20:06.294699+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-09-01T13:20:44.388573+02:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "2U8XQngtR1y7VBqvPd4ohQ=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "Usually this is {{gtClass:GtRemotePhlowConcreteDataViewSpecification}}, backed by {{gtClass:GtRemotePhlowConcreteDataViewDataSource}}; the datasource invokes the view's `computeViewData` (e.g., {{gtMethod:GtRemotePhlowPictureView>>#computeViewData}})."
									}
								]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:42.504741+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:48:26.127793+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "t27wNXGaSIKN4xIa5tZPVg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "2. When the view enters the declarative pipeline, {{gtMethod:name=GtRemotePhlowView>>#asGtDeclarativeView|label=#selector}} creates a **Specification** with a **Data Source** attached."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:43.586832+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:49:53.192967+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "YAW7qZS6TfCfglr9MFYy8Q=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "3. The specification is serialized via {{gtMethod:name=GtPhlowViewSpecification>>#asDictionaryForExport|label=#selector}} / {{gtMethod:name=GtPhlowViewSpecification>>#asBasicViewDataForExport|label=#selector}} for transport."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:44.914359+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:50:14.407236+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "rSJt/YVaQkOjJz65ftuzmQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "4. On the receiving side, {{gtMethod:GtPhlowViewSpecification class>>#fromDictionary:}} reconstructs the specification."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:45.96246+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:50:36.672905+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "FtAQxA2IT9iyhjhj05Nkxg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "5. {{gtMethod:GtPhlowViewSpecification>>#initializeFromInspector:|label=#selector}} reconnects the specification's data source (for lazy data transport)."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
