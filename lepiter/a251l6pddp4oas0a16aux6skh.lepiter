											"uidString" : "ZSvFDsI7QGu/FBumubs7Aw=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "3. **Data Source** (subclass of {{gtClass:GtRemotePhlowDeclarativeViewDataSource}}) — evaluates the view's computation blocks and produces view data. Wraps errors into {{gtClass:GtRemotePhlowViewErrorData}}."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
