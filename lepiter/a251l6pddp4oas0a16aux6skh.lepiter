							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Use a custom specification/datasource pair only when the generic concrete-data pipeline does not provide enough control. {{gtClass:GtRemotePhlowWebBrowserView}} is the reference implementation."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
