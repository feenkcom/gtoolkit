											"__type" : "textStyle"
										},
										"string" : "1. **View** (subclass of {{gtClass:GtRemotePhlowLocalView}}) — the view definition created by {{gtPragma:gtView}} methods. Holds computation blocks for producing the view's data."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-28T10:44:45.994351+03:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-28T10:44:45.994351+03:00"
											}
