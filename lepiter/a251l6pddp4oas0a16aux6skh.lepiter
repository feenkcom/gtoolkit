				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-27T22:57:18.204+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "8jkumpcx0USwDqRZw1wKQw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## Architecture Overview"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:39.688592+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:39.688592+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "NZidqiV2T/ufrtI0SWYLsA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The data flows through these stages:"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:41.206488+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:57.794435+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "goZl+pU6SUSjnu1A+i1+iA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "1. A {{gtPragma:gtView}} method calls `aView picture` (or similar) which creates the **View** instance and configures it with computation blocks."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:42.504741+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:48:26.127793+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "t27wNXGaSIKN4xIa5tZPVg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "2. When the view enters the declarative pipeline, {{gtMethod:name=GtRemotePhlowView>>#asGtDeclarativeView|label=#selector}} creates a **Specification** with a **Data Source** attached."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:43.586832+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:49:53.192967+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "YAW7qZS6TfCfglr9MFYy8Q=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "3. The specification is serialized via {{gtMethod:name=GtPhlowViewSpecification>>#asDictionaryForExport|label=#selector}} / {{gtMethod:name=GtPhlowViewSpecification>>#asBasicViewDataForExport|label=#selector}} for transport."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:44.914359+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:50:14.407236+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "rSJt/YVaQkOjJz65ftuzmQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "4. On the receiving side, {{gtMethod:GtPhlowViewSpecification class>>#fromDictionary:}} reconstructs the specification."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:45.96246+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:50:36.672905+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "FtAQxA2IT9iyhjhj05Nkxg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "5. {{gtMethod:GtPhlowViewSpecification>>#initializeFromInspector:|label=#selector}} reconnects the specification's data source (for lazy data transport)."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:46:47.013602+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-28T10:53:49.129013+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "xWQEfqy7Q/mCry0UlbF0hg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "6. When rendering, the specification and dadatasource provide methods that compute and return the  the relevant **View Data**. For example {{gtMethod:GtRemotePhlowPictureViewSpecification>>#retrieveData}} and {{gtMethod:GtRemotePhlowDeclarativePictureViewDataSource>>#retrieveData}} for the picture view."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-27T22:57:18.216+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-27T22:57:18.216+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "4Cy81P5k+E25AxNtMP1ajA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## Data Flow"
			},
