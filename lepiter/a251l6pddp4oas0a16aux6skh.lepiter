							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The browser view needs separate content and dynamic-header retrieval, static headers, specialized included-versus-lazy behavior, merging before rendering, and explicit local/remote cache invalidation. It therefore defines {{gtClass:GtRemotePhlowWebBrowserViewSpecification}} and {{gtClass:GtRemotePhlowDeclarativeWebBrowserViewDataSource}}."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
