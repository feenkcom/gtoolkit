				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "icc9stGcTu6gssYJfDvTAA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "#1. Find the process listening on the port."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:37:31.901529+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:51:46.713131+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "FwczenNJRayILgPJmvinwg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "`stopnetldi` and `stopstone` look for servers through the lock files in `$GEMSTONE_GLOBAL_DIR`. If the server was started with a different `GEMSTONE` or `GEMSTONE_GLOBAL_DIR` (setup scripts often use a per-workspace one), they report *\"Server ... is not running\"* even though it is. The shell snippet below reads the environment the process was launched with and stores it in the page variable `gemstoneEnv`. The Pharo snippet after it extracts `gemstoneHome` and `gemstoneGlobalDir` from that output. Run both, in order."
						},
						{
							"__type" : "shellCommandSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:37:31.960808+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:45:55.453681+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "/zXqzwjlQ52Ek2xC1P48FA=="
							},
							"code" : "PORT=50377\nPID=$(lsof -t -iTCP:$PORT -sTCP:LISTEN | head -1)\nif [ \"$(uname)\" = Darwin ]; then\n  ps -E -p \"$PID\" -o command= | tr ' ' '\\n' | grep '^GEMSTONE'\nelse\n  tr '\\0' '\\n' < \"/proc/$PID/environ\" | grep '^GEMSTONE'\nfi",
							"bindingName" : "gemstoneEnv"
						},
						{
							"__type" : "pharoSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:45:49.240202+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:45:49.240202+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "ivpmQS/vQ6CE1BTgGabaeQ=="
							},
							"code" : "\"Parse the shell output into page variables used by the stop snippet below\"\n| env |\nenv := (gemstoneEnv lines\n\tcollect: [ :each | (each copyUpTo: $=) -> (each copyAfter: $=) ]) asDictionary.\ngemstoneHome := env at: 'GEMSTONE'.\ngemstoneGlobalDir := env at: 'GEMSTONE_GLOBAL_DIR' ifAbsent: [ '/opt/gemstone' ].\nenv"
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-04T14:41:57.830381+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-04T14:51:43.872326+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "PeUzCG53S7W62rvYECj9Iw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "#2. Find out how it was started."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:37:32.03962+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:46:03.437434+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "q6wTGyfbQhSWjDz6toCNUA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Lepiter passes `gemstoneHome` and `gemstoneGlobalDir` from step 2 to the snippet below as environment variables (it does this for any string page variable whose name appears in a shell script). `gslist -l` lists the servers registered there. The snippet also stops the stone, since it would clash on its name too; if no stone is running, `stopstone` just reports that. Use these commands instead of `kill`: they shut the servers down cleanly and remove the lock files. **Check the `gslist` output first: this stops whatever is on the port, even your current installation.**"
						},
						{
							"__type" : "shellCommandSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:37:32.114103+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-04T14:53:33.439873+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "5hp5RTDZRCC6CbdkdxoafA=="
							},
							"code" : "export GEMSTONE=\"$gemstoneHome\"\nexport GEMSTONE_GLOBAL_DIR=\"$gemstoneGlobalDir\"\nexport PATH=\"$GEMSTONE/bin:$PATH\"\n\ngslist -l\nstopstone -i gs64stone DataCurator swordfish\nstopnetldi gs64ldi"
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-04T14:42:17.566021+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-11-04T14:51:59.606723+01:00"
					}
				},
				"uid" : {
