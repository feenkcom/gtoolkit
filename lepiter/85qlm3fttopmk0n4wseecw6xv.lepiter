				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "# How the mixed registry avoids it"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
