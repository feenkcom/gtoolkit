							"uid" : {
								"__type" : "uid",
								"uidString" : "oH6eUjijT5uM70ehPGoq+A=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "- Strong subscriptions still keep their subscribers alive, as they should.\n- A weak subscriber that has died can still receive announcements until the finalization process has removed it, shortly after the garbage collection that notices its death, exactly as with Pharo's weak subscriptions.\n"
						}
					]
				},
