									"dateAndTimeString" : "2026-11-22T16:45:40.208206+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "u3Uq128GTqSKV/KLualFCw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Strong and weak subscribers can therefore be mixed freely on one announcer: for example a page keeps its history as a strong subscriber and widgets subscribe weakly ({{gtMethod:GtMixedSubscriptionRegistryExamples>>#ownedStrongSubscriberLivesAsLongAsItsOwner}})."
						}
					]
				},
