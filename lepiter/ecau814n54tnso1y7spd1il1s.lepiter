								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-18T00:06:25.593667+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-18T00:06:25.593667+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "AxKvxUuCTeWmO5BXIRAvhA=="
							},
							"code" : "\"What the MCP server holds, and what only it keeps alive. Each walk takes about a minute.\"\n| metrics |\nmetrics := GtImageStateMemoryMetrics focusedOn: (GtMemorySpaceRootGroup\n\tlabel: 'MCP server'\n\troots: [ { GtLMcpServer classPool at: #Current } ]).\nmetrics retentionOf: { GtLMcpServer. GtLToolMessage. GtLMcpChatAdapter }"
						},
