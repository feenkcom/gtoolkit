								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-17T23:17:30.180467+01:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-11-17T23:17:30.180467+01:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "wkpFwYY8RP+HT5ohfGjVkA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "To look inside one object, make it the only root. A group can also split its roots with an attribution, for example a {{gtClass:GtMemorySpaceSlotsAttribution}} that sends each slot to its own category, when the object model is stable enough for slot names."
						},
